par VLAN.Switch3 typename "\"inet.node.ethernet.EthernetSwitch\""
par VLAN.Switch3 recordPcap false
par VLAN.Switch3 numPcapRecorders 0
par VLAN.Switch3 numApps 0
par VLAN.Switch3 hasStatus false
par VLAN.Switch3 hasStp false
par VLAN.Switch3 hasGptp false
par VLAN.Switch3 hasCutthroughSwitching false
par VLAN.Switch3 fcsMode "\"declared\""
attr enum declared,computed
par VLAN.Switch3 spanningTreeProtocol "\"Stp\""
par VLAN.Switch3 numEthInterfaces 0
par VLAN.configurator typename "\"inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator\""
par VLAN.configurator minLinkWeight 0.001
par VLAN.configurator configureIsolatedNetworksSeparatly false
par VLAN.configurator config "<config>...</config> at content:1"
par VLAN.configurator assignAddresses true
par VLAN.configurator assignUniqueAddresses true
par VLAN.configurator assignDisjunctSubnetAddresses true
par VLAN.configurator addStaticRoutes true
par VLAN.configurator addDefaultRoutes true
par VLAN.configurator addSubnetRoutes true
par VLAN.configurator addDirectRoutes true
par VLAN.configurator optimizeRoutes true
par VLAN.configurator dumpTopology false
par VLAN.configurator dumpLinks false
par VLAN.configurator dumpAddresses false
par VLAN.configurator dumpRoutes false
par VLAN.configurator dumpConfig "\"\""
par VLAN typename "\"topology.VLAN\""

