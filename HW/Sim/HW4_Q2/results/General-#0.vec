config *.aodvRouter1.mobility.constraintAreaMinY 50m
config *.aodvRouter1.mobility.constraintAreaMaxY 350m
config *.aodvRouter2.mobility.constraintAreaMinY 50m
config *.aodvRouter2.mobility.constraintAreaMaxY 350m
config *.aodvRouter1.mobility.initialMovementHeading 90deg
config *.aodvRouter2.mobility.initialMovementHeading 90deg
config **.transmitter.power 1mW
config **.displayCommunicationRange true
config *.*.routingApp.typename Aodv
config *.visualizer.*.numDataLinkVisualizers 5
config *.visualizer.*.dataLinkVisualizer[*].activityLevel "\"peer\""
config *.visualizer.*.dataLinkVisualizer[*].displayLinks true
config *.visualizer.*.dataLinkVisualizer[0].packetFilter "\"*ping*\""
config *.visualizer.*.dataLinkVisualizer[0].Color "\"blue\""
